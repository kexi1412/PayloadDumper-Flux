{
  "name": "payload-dumper-flux-desktop",
  "version": "3.2.0-pc.1",
  "description": "Payload Dumper Flux native Windows firmware workbench",
  "private": true,
  "author": "Payload Dumper Flux contributors",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "test": "node --test tests/*.test.cjs",
    "test:engine": "node tests/engine-smoke.cjs",
    "test:engine:jvm": "node scripts/test-jvm.cjs",
    "test:ui": "node tests/native-ui-smoke.cjs",
    "engine:build": "cargo build --manifest-path native-engine/Cargo.toml --release",
    "engine:test": "cargo test --manifest-path native-engine/Cargo.toml",
    "engine:jvm": "node scripts/build-engine.cjs",
    "package:win": "tauri build --bundles nsis",
    "verify:package": "node scripts/verify-native-package.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "puppeteer-core": "25.14.0",
    "typescript": "5.7.3",
    "vite": "6.3.5"
  }
}
